{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "MesaNote",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#code_block" },
		{ "include": "#inline_code" },
		{ "include": "#escape" },
		{ "include": "#sections" },
		{ "include": "#definitions" },
		{ "include": "#tables" },
		{ "include": "#lists" },
		{ "include": "#groupings" },
		{ "include": "#string_symbols" },
		{ "include": "#symbols" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "name": "comment.line.double-slash", "match": "//.*$" }
			]
		},
		"escape": {
			"patterns": [
				{ "name": "constant.character.escape.mesanote", "match": "\\\\." }
			]
		},
		"code_block": {
			"begin": "^\\s*(`+)\\s*$",
			"beginCaptures": {
				"1": { "name": "keyword.operator.punctuation.mesanote" }
			},
			"end": "^\\s*\\1\\s*$",
			"endCaptures": {
				"0": { "name": "keyword.operator.punctuation.mesanote" }
			},
			"name": "string.quoted.other.backtick.mesanote",
			"contentName": "string.quoted.other.backtick.mesanote",
			"patterns": []
		},
		"inline_code": {
			"patterns": [
				{
					"name": "string.quoted.other.backtick.mesanote",
					"begin": "(`)",
					"beginCaptures": {
						"1": { "name": "keyword.operator.punctuation.mesanote" }
					},
					"end": "(`)",
					"endCaptures": {
						"1": { "name": "keyword.operator.punctuation.mesanote" }
					},
					"contentName": "string.quoted.other.backtick.mesanote",
					"patterns": []
				}
			]
		},
		"string_symbols": {
			"patterns": [
				{
					"begin": "([*]{2})",
					"beginCaptures": {
						"1": { "name": "keyword.operator.mesanote" }
					},
					"end": "([*]{2})",
					"endCaptures": {
						"1": { "name": "keyword.operator.mesanote" }
					},
					"name": "markup.bold.mesanote",
					"patterns": []
				},
				{
					"begin": "([*])",
					"beginCaptures": {
						"1": { "name": "keyword.operator.mesanote" }
					},
					"end": "([*])",
					"endCaptures": {
						"1": { "name": "keyword.operator.mesanote" }
					},
					"name": "markup.italic.mesanote",
					"patterns": []
				},
				{ "include": "#escape" }
			]
		},
		"groupings": {
			"begin": "\\{",
			"beginCaptures": { "0": { "name": "keyword.operator.punctuation.mesanote" } },
			"end": "\\}",
			"endCaptures": { "0": { "name": "keyword.operator.punctuation.mesanote" } },
			"name": "meta.grouping.mesanote",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#sections" },
				{ "include": "#tables" },
				{ "include": "#lists" },
				{ "include": "#definitions" },
				{ "include": "#code_block" },
				{ "include": "#inline_code" },
				{ "include": "#escape" },
				{ "include": "#string_symbols" },
				{ "include": "#groupings" },
				{ "include": "#symbols" }
			]
		},
		"sections": {
			"patterns": [
				{
					"name": "meta.section.block.mesanote",
					"begin": "^\\s*(>+)\\s*$",
					"beginCaptures": {
						"1": { "name": "keyword.operator.table.mesanote" }
					},
					"end": "^\\s*([^\\{|\\n]+?)(?=\\s*[\\{|]|$)",
					"endCaptures": {
						"1": { "name": "entity.name.section.title.mesanote" }
					},
					"patterns": [
						{ "include": "#escape" },
						{ "include": "#inline_code" },
						{ "include": "#string_symbols" },
						{ "include": "#symbols" }
					]
				},
				{
					"name": "meta.section.mesanote",
					"match": "^\\s*(>+)(?:\\s*)([^\\{|\\n]+?)(?=\\s*[\\{|]|$)",
					"captures": {
						"1": { "name": "keyword.operator.table.mesanote" },
						"2": { "name": "entity.name.section.title.mesanote" }
					}
				}
			]
		},
		"lists": {
			"patterns": [
				{ "match": "^\\s*(\\+)", "captures": { "1": { "name": "keyword.operator.list.mesanote" } } }
			]
		},
		"definitions": {
			"patterns": [
				{
					"name": "meta.definition.block.mesanote",
					"begin": "^\\s*(@)\\s*$",
					"beginCaptures": {
						"1": { "name": "keyword.operator.definition.mesanote" }
					},
					"end": "^\\s*([^|\\n]+?)(?=\\s*\\||$)",
					"endCaptures": {
						"1": { "name": "entity.name.definition.term.mesanote" }
					},
					"patterns": [
						{ "include": "#escape" },
						{ "include": "#inline_code" },
						{ "include": "#string_symbols" },
						{ "include": "#symbols" }
					]
				},
				{
					"name": "meta.definition.term.mesanote",
					"begin": "^\\s*(@)\\s*",
					"beginCaptures": {
						"1": { "name": "keyword.operator.definition.mesanote" }
					},
					"end": "(?=\\s*\\|)|$",
					"contentName": "entity.name.definition.term.mesanote",
					"patterns": [
						{ "include": "#escape" },
						{ "include": "#inline_code" },
						{ "include": "#string_symbols" },
						{ "include": "#symbols" }
					]
				},
				{
					"name": "meta.definition.content.mesanote",
					"begin": "(\\|)\\s*",
					"beginCaptures": {
						"1": { "name": "keyword.operator.punctuation.mesanote" }
					},
					"end": "$",
					"contentName": "meta.definition.content.mesanote",
					"patterns": [
						{ "include": "#escape" },
						{ "include": "#inline_code" },
						{ "include": "#string_symbols" },
						{ "include": "#symbols" }
					]
				}
			]
		},
		"tables": {
			"patterns": [
				{ "match": "^\\s*(#+)", "captures": { "1": { "name": "keyword.operator.table.mesanote" } } }
			]
		},
		"symbols": {
			"patterns": [
				{ "name": "keyword.operator.punctuation.mesanote", "match": "[\\{\\}\\|>\\+]" },
				{ "name": "keyword.control.mesanote", "match": "[|>+]" }
			]
		}
	},
	"scopeName": "text.mesanote"
}
