{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "MesaNote",
	"scopeName": "text.mesanote",
	"patterns": [
		{
			"include": "#element"
		}
	],
	"repository": {
		"element": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#section"
				},
				{
					"include": "#definition"
				},
				{
					"include": "#list"
				},
				{
					"include": "#table"
				},
				{
					"include": "#grouping"
				},
				{
					"include": "#string"
				},
				{
					"include": "#symbols"
				}
			]
		},
		"comment": {
			"name": "comment.line.double-slash",
			"begin": "//",
			"end": "\\n"
		},
		"grouping": {
			"name": "meta.grouping.mesanote",
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			},
			"endCaptures": {
				"0": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#element"
				}
			]
		},
		"section": {
			"name": "meta.section.mesanote",
			"begin": "(>)",
			"end": "(\\|)|(?:(?<=[^\\s>])|(?<=\\\\>))[ \\t]*\\n|(?=[{}>+#@]|//)",
			"contentName": "entity.name.section.title.mesanote",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.table.mesanote"
				}
			},
			"endCaptures": {
				"1": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#inline"
				}
			]
		},
		"list": {
			"name": "meta.list.mesanote",
			"begin": "(\\+)",
			"end": "(?<=\\})|(?=[^\\s{])",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.list.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#grouping"
				}
			]
		},
		"table": {
			"name": "meta.table.mesanote",
			"begin": "(#)",
			"end": "(?<=\\})|(?=[^\\s{])",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.table.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#grouping"
				}
			]
		},
		"definition": {
			"name": "meta.definition.mesanote",
			"begin": "(@)",
			"end": "(\\|)|(?:(?<=[^\\s@])|(?<=\\\\@))[ \\t]*\\n|(?=[{}>+#@]|//)",
			"contentName": "entity.name.definition.term.mesanote",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.definition.mesanote"
				}
			},
			"endCaptures": {
				"1": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#inline"
				}
			]
		},
		"string": {
			"name": "meta.string.mesanote",
			"begin": "(?=[^\\s{}>+@#|])(?!//)",
			"end": "(\\|)|\\n|(?=[{}>+#@]|//)",
			"endCaptures": {
				"1": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#inline"
				}
			]
		},
		"symbols": {
			"name": "keyword.operator.punctuation.mesanote",
			"match": "[|}]"
		},
		"inline": {
			"patterns": [
				{
					"include": "#escape"
				},
				{
					"include": "#code"
				},
				{
					"include": "#strong"
				},
				{
					"include": "#weak"
				}
			]
		},
		"escape": {
			"patterns": [
				{
					"name": "constant.character.escape.mesanote",
					"match": "\\\\(?://|[\\\\*`|{}>+#@])"
				},
				{
					"name": "invalid.illegal.escape.mesanote",
					"match": "\\\\."
				}
			]
		},
		"code": {
			"name": "string.quoted.other.backtick.mesanote",
			"begin": "(`+)",
			"end": "(?<!`)(\\1)(?!`)",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			},
			"endCaptures": {
				"1": {
					"name": "keyword.operator.punctuation.mesanote"
				}
			}
		},
		"strong": {
			"name": "markup.bold.mesanote",
			"begin": "(\\*\\*)",
			"end": "(\\*\\*)|(?=\\||\\n|[{}>+#@`]|//)",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.mesanote"
				}
			},
			"endCaptures": {
				"1": {
					"name": "keyword.operator.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#escape"
				},
				{
					"include": "#weak"
				}
			]
		},
		"weak": {
			"name": "markup.italic.mesanote",
			"begin": "(\\*)(?!\\*)",
			"end": "(\\*)|(?=\\||\\n|[{}>+#@`]|//)",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.mesanote"
				}
			},
			"endCaptures": {
				"1": {
					"name": "keyword.operator.mesanote"
				}
			},
			"patterns": [
				{
					"include": "#escape"
				}
			]
		}
	}
}